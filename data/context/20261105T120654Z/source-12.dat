<style type="text/css">
    .skip-link {
        position: absolute;
        left: -9999px;
        top: auto;
    }

        .skip-link:focus {
            left: 10px;
            top: 10px;
            background: #000;
            color: #fff;
            padding: 8px 16px;
            z-index: 1000;
        }

    .top-acess a:focus, .top-acess a:hover {
        color: #ECF3FA !important;
    }

    .form-control:focus {
        border-color: #092840 !important;
    }

    .top-acess li.icon:hover {
        background: #000 !important;
    }

    span.home:hover, span.rss:hover, span.subscribe:hover {
        background-color: #000 !important;
    }

    .selector-label {
        display: block;
        margin-bottom: 4px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
    }

    #example1 li.dropdown .dropdown-content {
        display: none !important;
    }

    #example1 li.dropdown > .theme-toggle[aria-expanded="true"] + .dropdown-content {
        display: block !important;
    }


    /* Header search box - DBIM 3.0 sections 5.4 and 9(v). Sized so the
       field is usable rather than token, and the button meets the 44px
       target guidance. */
    .pib-headsearch {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        vertical-align: middle;
    }

    .pib-headsearch-input {
        width: 190px;
        max-width: 40vw;
        height: 30px;
        padding: 2px 8px;
        border: 1px solid #ffffff;
        border-radius: 3px;
        color: var(--dbim-text, #150202)   /* was #212121 - the input ground is #ffffff, so 19.1:1 */;
        background: #ffffff;
        font-size: 13px;
    }

    .pib-headsearch-go {
        height: 30px;
        min-width: 32px;
        border: 1px solid #ffffff;
        border-radius: 3px;
        background: transparent;
        color: #ffffff;
        cursor: pointer;
        font-size: 15px;
        line-height: 1;
    }

        .pib-headsearch-go:hover,
        .pib-headsearch-go:focus {
            background: #ffffff;
            color: #000000;
        }

    html.pib-hc .pib-headsearch-input {
        background: #150202 !important;
        color: #ffffff !important;
        border-color: #ffff00 !important;
    }

    html.pib-hc .pib-headsearch-go {
        color: #ffff00 !important;
        border-color: #ffff00 !important;
    }

    @media (max-width: 767px) {
        .pib-headsearch-input { width: 130px; }
    }
</style>
