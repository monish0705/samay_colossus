    <style type="text/css">
 .breadcrumb > .active {
  color: #505050 !important;
}
        :focus-visible {
            outline: 2px solid #000000 !important;
            outline-offset: 2px !important;
            /*box-shadow: 0 0 0 2px #000000 !important;*/
        }

