{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    }
  ]
}
