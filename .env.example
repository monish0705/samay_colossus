SAMAY_ENVIRONMENT=development
SAMAY_DATABASE_URL=sqlite:///./samay.db
SAMAY_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional trusted artifact registry; keep unset until real models are deployed.
# SAMAY_SERVICE_REGISTRY_PATH=service-registry.json
# Hash-verified retrospective results; separate from validated operational models.
SAMAY_RESEARCH_REGISTRY_PATH=research-registry.json
# Optional OFFLINE HISTORICAL REPLAY only after authentic archives/artifacts are prepared.
# Past decision date, development/test environments only. Visible banner; never live data.
# SAMAY_HISTORICAL_DEMO_DATE=2025-11-04

# Explicit limited-evidence research inference, never validated hold advice.
SAMAY_ENABLE_RESEARCH_FORECASTS=true
SAMAY_RESEARCH_SERVING_REGISTRY_PATH=research-serving-registry.json
# Optional OGD operator key. If absent, the collector uses the download credential
# published by the official resource page. Credentials are never archived/logged.
# SAMAY_OGD_API_KEY=

# Sale requests require a durable database. Local SQLite is durable on this computer.
SAMAY_MARKETPLACE_ENABLED=true
# Canonical deployed frontend origin; used in external notification links.
# SAMAY_PUBLIC_APP_URL=https://your-authorized-domain.example
# SMTP requires STARTTLS; secrets belong only in .env or hosting secret storage.
# SAMAY_SMTP_HOST=
SAMAY_SMTP_PORT=587
# SAMAY_SMTP_FROM=
# SAMAY_SMTP_USERNAME=
# SAMAY_SMTP_PASSWORD=
# Optional Twilio messaging. Verify recipients and collect channel-specific consent.
# SAMAY_TWILIO_ACCOUNT_SID=
# SAMAY_TWILIO_AUTH_TOKEN=
# SAMAY_TWILIO_SMS_FROM=
# SAMAY_TWILIO_WHATSAPP_FROM=whatsapp:+YOUR_APPROVED_SENDER
# Approved templates must have one variable containing the localized request update.
# SAMAY_TWILIO_WHATSAPP_CONTENT_SID_EN=
# SAMAY_TWILIO_WHATSAPP_CONTENT_SID_KN=
# Vercel only: provision a shared durable SQL database and driver before setting this.
# SAMAY_PERSISTENT_DATABASE_URL=
